# Copy to .env  (never commit .env)
DATABASE_URL=postgres://user:password@localhost:5432/foodexpress
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# Used only by `npm run create-admin` (first admin is never seeded with a default password)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
